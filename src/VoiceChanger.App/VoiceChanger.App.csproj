<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>VoiceChanger.App</RootNamespace>
    <AssemblyName>VoiceChanger</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoiceChanger.Core\VoiceChanger.Core.csproj" />
    <ProjectReference Include="..\VoiceChanger.Audio.Wasapi\VoiceChanger.Audio.Wasapi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VoiceChanger.App.Tests" />
  </ItemGroup>

</Project>
