<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VoiceChanger.App.ViewModels"
             xmlns:views="using:VoiceChanger.App.Views"
             x:Class="VoiceChanger.App.Views.PluginEffectEditor"
             x:DataType="vm:PluginEffectViewModel">
  <StackPanel Spacing="10">
    <Border Classes="hint" IsVisible="{Binding HasProblem}">
      <TextBlock x:Name="PluginProblem" Text="{Binding Problem}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
    </Border>
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBlock Classes="muted" Text="{Binding HostingText}" VerticalAlignment="Center" />
      <Button Grid.Column="1"
              x:Name="PluginWindowButton"
              Content="{Binding WindowButtonText}"
              Command="{Binding ToggleWindowCommand}"
              IsVisible="{Binding HasWindow}"
              ToolTip.Tip="The plug-in's own controls, in a window of their own" />
    </Grid>
    <views:GenericEffectEditor />
  </StackPanel>
</UserControl>
