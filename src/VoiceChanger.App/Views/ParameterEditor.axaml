<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VoiceChanger.App.ViewModels"
             x:Class="VoiceChanger.App.Views.ParameterEditor"
             x:DataType="vm:ParameterViewModel">
  <!-- One effect setting: a slider, a list of choices, a row of buttons or an on/off switch. -->
  <StackPanel Spacing="2"
              Background="Transparent"
              IsEnabled="{Binding IsAvailable}"
              ToolTip.Tip="{Binding ToolTip}"
              ToolTip.ShowOnDisabled="True">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
      <TextBlock Classes="label" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
      <Button Grid.Column="1"
              Classes="reset"
              IsVisible="{Binding CanReset}"
              Command="{Binding ResetCommand}"
              ToolTip.Tip="{Binding DefaultText, StringFormat='Reset to {0}'}">
        <Path Classes="icon" Data="{StaticResource IconReset}" />
      </Button>
      <TextBlock Grid.Column="2"
                 Classes="value"
                 IsVisible="{Binding IsSlider}"
                 Text="{Binding DisplayValue}" />
    </Grid>

    <Slider IsVisible="{Binding IsSlider}"
            Minimum="0"
            Maximum="1"
            SmallChange="{Binding SmallChange}"
            LargeChange="0.1"
            Value="{Binding Position}" />

    <ComboBox IsVisible="{Binding IsChoice}"
              ItemsSource="{Binding Choices}"
              SelectedIndex="{Binding SelectedIndex}"
              HorizontalAlignment="Stretch"
              Margin="0,6,0,8" />

    <Border Classes="segmented"
            IsVisible="{Binding IsButtons}"
            Margin="0,6,0,8">
      <ItemsControl ItemsSource="{Binding Options}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ChoiceOptionViewModel">
            <RadioButton Theme="{StaticResource SegmentRadioButton}"
                         HorizontalAlignment="Stretch"
                         Padding="8,5"
                         Content="{Binding Label}"
                         IsChecked="{Binding IsSelected}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <ToggleSwitch IsVisible="{Binding IsToggle}"
                  IsChecked="{Binding IsOn}" />
  </StackPanel>
</UserControl>
