<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VoiceChanger.App.ViewModels"
             x:Class="VoiceChanger.App.Views.ParameterEditor"
             x:DataType="vm:ParameterViewModel">
  <!-- One effect setting: a slider, a list of choices or an on/off switch. -->
  <StackPanel Spacing="2"
              Background="Transparent"
              IsEnabled="{Binding IsAvailable}"
              ToolTip.Tip="{Binding Description}"
              ToolTip.ShowOnDisabled="True">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBlock Classes="label" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="1"
                 Classes="value"
                 IsVisible="{Binding IsSlider}"
                 Text="{Binding DisplayValue}" />
    </Grid>

    <Slider IsVisible="{Binding IsSlider}"
            Minimum="0"
            Maximum="1"
            SmallChange="{Binding SmallChange}"
            LargeChange="0.1"
            Value="{Binding Position}" />

    <ComboBox IsVisible="{Binding IsChoice}"
              ItemsSource="{Binding Choices}"
              SelectedIndex="{Binding SelectedIndex}"
              HorizontalAlignment="Stretch"
              Margin="0,6,0,8" />

    <ToggleSwitch IsVisible="{Binding IsToggle}"
                  IsChecked="{Binding IsOn}" />
  </StackPanel>
</UserControl>
