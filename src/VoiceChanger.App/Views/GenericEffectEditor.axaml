<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VoiceChanger.App.ViewModels"
             xmlns:views="using:VoiceChanger.App.Views"
             x:Class="VoiceChanger.App.Views.GenericEffectEditor"
             x:DataType="vm:EffectViewModel">
  <!-- Every parameter of the effect, two per row. -->
  <ItemsControl ItemsSource="{Binding Parameters}" Margin="-12,0">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <UniformGrid Columns="2" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="vm:ParameterViewModel">
        <views:ParameterEditor Margin="12,0,12,6" />
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
